# AI through OpenRouter (https://openrouter.ai/keys), FREE MODELS ONLY: roadmaps never cost anything.
# Without a key, roadmaps fall back to the free built-in city data.
OPENROUTER_API_KEY=
# Optional: another free model (must be "openrouter/free" or end in ":free"; anything else is ignored). Default: openrouter/free
OPENROUTER_MODEL=

# The home page's "AI research" mode uses the same OpenRouter key and free model. No other AI key is needed.

# Supabase (email/password auth). Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_…). The older NEXT_PUBLIC_SUPABASE_ANON_KEY name also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Payments: Paystack, TEST MODE ONLY (sk_test_… keys; live keys are refused).
# Dashboard → Settings → API Keys & Webhooks (with the "Test mode" switch on).
# The secret key also signs Paystack's webhooks, so there is no separate webhook secret.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Optional: the price is USD $19. If your Paystack account can't take USD, set both (smallest unit, so 3000000 = ₦30,000):
PAYSTACK_PRICE_CURRENCY=
PAYSTACK_PRICE_MINOR=
# Optional: where Paystack sends buyers back to (defaults to the request's own origin).
NEXT_PUBLIC_SITE_URL=

# SERVER ONLY, never prefix with NEXT_PUBLIC_. Supabase → Project Settings → API → service_role key.
# Lets the Paystack webhook switch a user to premium. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
